#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main () {
    
    
    srand(time(NULL));
  
    int guess = 0;
    int tries = 0;
    int min = 1;
    int max = 100;
    int answer = (rand() % (max - min + 1)) + min;
    
    printf("Guessing Game\n");
    
    do{
    printf("Guess number 1-100: ");
    scanf("%d", &guess);
    tries++;
        
        if(guess < answer){
            printf("too low\n");
        }else if(guess > answer){
            printf("too high\n");
        }else{
            printf("correct");
        }
        
    }while(guess != answer);
    
    printf("answer %d\n ", answer);
    printf("It took %d tries", tries);
    
    
    
  
    return 0;
}
